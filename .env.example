# 大模型 API Key（必填）
# 阿里云百炼：https://bailian.console.aliyun.com/
OPENAI_API_KEY=sk-your-api-key-here

# 模型名称（可选）
# 通义千问示例：qwen3.8-max | qwen3.7-plus | qwen-plus | qwen-max
OPENAI_MODEL=qwen3.8-max

# OpenAI 兼容端点（通义千问百炼）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 关闭思考链（千问默认会自动关闭；其他模型可设为 true）
# DISABLE_THINKING=true

# OCR 配置（扫描版 PDF 自动启用）
OCR_MAX_PAGES=15
TESSERACT_LANG=chi_sim+eng

# PostHog 产品分析 / Session Replay / Web Analytics（可选；不填则关闭埋点）
# 控制台：https://us.posthog.com 或 https://eu.posthog.com
# 官方文档变量名（二选一即可，也兼容下方的 KEY 别名）
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog 后台数据查询（/admin 大盘与分析详情）
# Personal API Key 需要 query:read 权限；不要使用 phs_ 开头的 project secret key
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# Supabase 业务数据后台（可选；配置后会保存分析记录与反馈）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# /admin 后台访问密码
ADMIN_PASSWORD=
